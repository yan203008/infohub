# Local-only secrets. Copy this file to .env.local and fill in the values.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1
MOONSHOT_MODEL=k3-256k
MOONSHOT_EDITOR_MODEL=k3-256k
SUPADATA_API_KEY=
# Only the administrator uses this password. Ordinary readers never sign in.
ADMIN_PASSWORD=

# Use a long random value. The same value is configured in the hosted app and
# in GitHub Actions so only the collector can write public content.
INGEST_SECRET=

# Local collector target. Leave blank to create a local output preview only.
INFOHUB_BASE_URL=
